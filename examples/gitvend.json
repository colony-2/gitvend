{
  "listen": "127.0.0.1:8443",
  "tls_cert": "/run/secrets/gitvend.crt",
  "tls_key": "/run/secrets/gitvend.key",
  "state_file": "var/gitvend.db",
  "audience": "gitvend",
  "keys": [
    {
      "id": "orchestrator-1",
      "issuer": "orchestrator",
      "public_key_file": "var/signing.pub",
      "owners": { "github.com": ["fooorg"] }
    }
  ],
  "providers": [
    {
      "alias": "github",
      "host": "github.com",
      "kind": "github",
      "git_base_url": "https://github.com",
      "api_base_url": "https://api.github.com",
      "allowed_owners": ["fooorg"],
      "credential": { "kind": "token", "secret_ref": "env:GITHUB_TOKEN" },
      "allow_creation": true
    }
  ],
  "denies": ["!github.com/fooorg/*#(main|master):wd"]
}
